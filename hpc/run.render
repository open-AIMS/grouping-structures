#!/bin/bash
#SBATCH --job-name=grp-render
#SBATCH --partition=cpuq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96GB
#SBATCH --time=16:00:00
#SBATCH --output=logs/grp-render-%j.log
#
# Renders example8 from the store, in the exported bayesnec source and against
# the job library, behind the post-fit array that hpc/run.post submits. Every
# fit is read from the store, and every post-fit call the array stored is read
# from <store>/post/. A call the array did not reach is computed here and
# recorded, so that a later render reads it too; post-log.tsv in the staged
# output lists each call and whether it was read or computed.
#
# The rendered .Rmd and the figures this run wrote are staged in
# render/<store>/ with a STAMP naming the bayesnec commit. Fetch them from
# there: the next deploy replaces bayesnec-src/.

set -euo pipefail
STUDY="${GRP_STUDY:-/export/scratch/$USER/grouping-structures}"
source "$STUDY/hpc/job-common.sh"

grp_check_bayesnec
STORE_DIR="$STUDY/${GRP_STORE:-store}"
OUT="$STUDY/render/${GRP_STORE:-store}"
STARTED="$STUDY/logs/grp-render-started-${SLURM_JOB_ID:-single}"
touch "$STARTED"

singularity exec -B "$STUDY":"$STUDY" --pwd "$SRC" "${RENV[@]}" \
  --env BAYESNEC_PRECOMPILE_PACKAGE=installed \
  --env BAYESNEC_STAN_CACHE="$CACHE" \
  --env BAYESNEC_FIT_STORE="$STORE_DIR" \
  --env BAYESNEC_POST_STORE_RECORD=true \
  --env BAYESNEC_POST_STORE_LOG="$STUDY/logs/grp-render-post-${SLURM_JOB_ID:-single}.tsv" \
  --env SLURM_CPUS_PER_TASK="${SLURM_CPUS_PER_TASK:-8}" \
  "$SIF" Rscript vignettes/precompile.R example8

# Reached only when precompile.R exited zero, which it does not where a chunk
# errored.
rm -rf "$OUT"; mkdir -p "$OUT"
cp "$SRC/vignettes/example8.Rmd" "$OUT/"
find "$SRC/vignettes" -name 'vignette-fig-*.png' -newer "$STARTED" \
  -exec cp {} "$OUT/" \;
cp "$STUDY/logs/grp-render-post-${SLURM_JOB_ID:-single}.tsv" "$OUT/post-log.tsv" \
  2>/dev/null || true
{
  echo "job: ${SLURM_JOB_ID:-none}"
  grep -E '^(ref|commit): ' hpc/bayesnec.lock
  echo "store: $STORE_DIR"
  echo "finished: $(date -Is)"
} > "$OUT/STAMP"
echo "=== $(date -Is) staged $(ls "$OUT" | wc -l) file(s) in $OUT"
